FROM python:3.12-slim

# Terminal çıktılarının anında basılması için
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Yalnızca CPU odaklı PyTorch ve temel kütüphaneler (toplam ~500 MB)
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu \
    numpy

CMD ["python", "app.py"]
